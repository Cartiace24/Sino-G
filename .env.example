# Supabase — copy to .env.local (Vite also reads .env.local automatically)
# NEVER put real credentials in this file: it is safe to commit.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: used for the Google OAuth button state only (configured in Supabase Auth dashboard)
# VITE_APP_URL=http://localhost:5173
